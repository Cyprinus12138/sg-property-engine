# sg-property-engine — environment reference. Copy to .env for local runs
# (the binary loads .env from the working directory if present). Everything
# here can also live in a YAML file — see sgpe.example.yaml.
#
# Variables override the YAML, so defaults are left commented out here: an
# uncommented line in .env would silently win over the same key in sgpe.yaml.
# Empty values count as unset.

# ─── Database ───────────────────────────────────────────────────────────────
# Postgres with the PostGIS extension available. DATABASE_URL is accepted as
# an alias so hosted Postgres providers' default variable works unchanged.
# Leave empty to have sgpe start a local PostGIS container through Docker
# (development only — see the SGPE_DB_* block below).
SGPE_DB_URL=

# ─── Config file ────────────────────────────────────────────────────────────
# YAML config (see sgpe.example.yaml). Default: ./sgpe.yaml if present.
# Variables in this file override the YAML.
SGPE_CONFIG=

# ─── Local database (used only when SGPE_DB_URL is empty) ───────────────────
# sgpe runs/reuses a PostGIS container bound to 127.0.0.1 with data in a
# named volume. Set SGPE_DB_AUTO_DOCKER=false to require an explicit URL.
# SGPE_DB_AUTO_DOCKER=true
# SGPE_DB_DOCKER_IMAGE=postgis/postgis:16-3.4
# SGPE_DB_DOCKER_CONTAINER=sgpe-postgis
# SGPE_DB_DOCKER_VOLUME=sgpe-pgdata
# Host port; 0 lets Docker pick a free one.
# SGPE_DB_DOCKER_PORT=55432

# ─── Server ─────────────────────────────────────────────────────────────────
# SGPE_PORT=8081
# SGPE_LOG_LEVEL=info            # debug | info | warn | error
# Prometheus scrape listener (e.g. :2112). Empty disables /metrics.
SGPE_METRICS_ADDR=
# Trigger a backfill at boot for every source with no successful run yet.
# Default off: a fresh database stays empty until you POST /sync/run.
# SGPE_BOOTSTRAP_ON_BOOT=false

# ─── Upstream credentials (all optional; a missing key disables that source) ─
# URA Data Service access key — private transactions, rentals, pipeline,
# developer sales. Free; register at
# https://eservice.ura.gov.sg/uraDataService/register
URA_ACCESS_KEY=

# OneMap account — required for the Themes API (POI ingest: kindergartens,
# hawker centres, parks, hospitals). Geocoding search works without it.
# Register at https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# LTA DataMall account key — bus stops. Free; request at
# https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# Google Maps Platform key — optional geocoding fallback (Places Text Search)
# when OneMap has no result. Billed by Google; leave empty to disable.
GOOGLE_MAPS_API_KEY=

# ─── Scheduler (cron, server-local time; defaults are off-peak SGT) ─────────
# SGPE_CRON_HDB=0 2 * * *
# SGPE_CRON_CEA=30 2 * * *
# SGPE_CRON_CEA_TXN=45 2 * * *
# SGPE_CRON_URA_TXN=0 3 * * *
# SGPE_CRON_URA_RENT=30 3 * * *
# SGPE_CRON_URA_PIPE=45 3 * * *
# SGPE_CRON_URA_DEV_SALES=0 4 * * *
# SGPE_CRON_GEO=15 4 * * *
# SGPE_CRON_POIS=0 5 * * 1
# SGPE_CRON_NEARBY_MRT=0 6 * * *

# OneMap themes to ingest as POIs (friendly names or raw OneMap queryNames).
# SGPE_POI_THEMES=kindergartens,hawker,park,hospital
